// 27. Tag（租客标签字典）与 TenantTag（租客-标签关联）
// docs/00 §2.1 / §3.3 P0：租客「标签管理」。字典由管理者维护，
// 避免自由文本导致「学生 / 学生党 / 在校生」并存而无法筛选。
model Tag {
  id   String @id @default(cuid())
  name String @unique
  /// 展示排序，小在前
  sort Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants TenantTag[]

  @@index([sort])
  @@map("tags")
}

model TenantTag {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([tenantId, tagId])
  @@index([tagId])
  @@map("tenant_tags")
}

// 28. PublicUtilityBill（公共水电费用单据）与 PublicUtilityAllocation（分摊明细）
// docs/09 §7：第一版公共区域水电只记运营成本；分摊规则放第二阶段（T217）。
// 分摊基数取「计费月内生效中的合同所覆盖房间」的建筑面积占比，总额按分向下取整后
// 把余额补给金额最大的一笔，保证分摊合计与单据总额完全相等。
model PublicUtilityBill {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])

  meterType MeterType
  period    String

  /// 公共表读数链路（可选）：从哪块公共表、哪两笔读数算出用量
  meterId        String?
  meter          Meter?   @relation(fields: [meterId], references: [id])
  openingReading Decimal? @db.Decimal(10, 2)
  closingReading Decimal? @db.Decimal(10, 2)
  usage          Decimal? @db.Decimal(10, 2)

  unitPrice   Int
  /// 总额（分）。按用量自动算出，或在直接录入总额时使用
  totalAmount Int

  notes String? @db.Text

  createdById String
  /// 补缴账单生成时间；null 表示尚未向租客开单
  billsGeneratedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  allocations PublicUtilityAllocation[]

  @@unique([buildingId, meterType, period])
  @@index([period])
  @@map("public_utility_bills")
}

model PublicUtilityAllocation {
  id     String            @id @default(cuid())
  billId String
  bill   PublicUtilityBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /// 分摊基数（平方米 ×100 取整），避免浮点比较
  baseAreaHundredths Int
  amount             Int

  createdAt DateTime @default(now())

  @@unique([billId, contractId])
  @@index([contractId])
  @@map("public_utility_allocations")
}

// 38. SystemSetting（业务设置中心，T276）
model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// 41. Announcement（公告与定向消息，COM-04 / T284）
// 公告本身只保存目标描述，发布时按目标解析出用户并复用通知中心（站内 + WebSocket）。
model Announcement {
  id    String @id @default(cuid())
  title String
  body  String @db.Text

  priority NotificationPriority @default(NORMAL)

  status   AnnouncementStatus   @default(DRAFT)
  audience AnnouncementAudience @default(ALL_TENANTS)

  /// 目标范围：BUILDING=楼栋 ID，TAGS=标签 ID，TENANTS=租客 ID；ALL_TENANTS 忽略
  targetIds String[]

  /// 计划发布时间；为空表示发布动作立即生效
  publishAt DateTime?
  expiredAt DateTime?

  createdBy String
  creator   User   @relation("AnnouncementCreator", fields: [createdBy], references: [id])

  publishedAt    DateTime?
  /// 最近一次发布成功投递的用户数（重发按去重键幂等）
  recipientCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([audience])
  @@map("announcements")
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL_TENANTS
  BUILDING
  TAGS
  TENANTS
}

// 46. Lead（意向线索，LSE-01 / T298）
