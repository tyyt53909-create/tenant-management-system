// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 枚举定义
// ============================================

// 房间类型
enum RoomType {
  SINGLE // 单间
  ONE_BED // 一室
  TWO_BED // 两室
  THREE_BED // 三室
  STUDIO // 开间
}

// 房间状态
enum RoomStatus {
  VACANT // 空置
  RESERVED // 预订（已签合同未入住）
  OCCUPIED // 已租
  MAINTENANCE // 维修中
}

// 清洁状态
enum CleanStatus {
  CLEAN // 已清洁（可出租）
  PENDING_CLEAN // 待清洁
  CLEANING // 清洁中
}

// 意向线索状态
enum LeadStatus {
  NEW // 新留资待跟进
  FOLLOWING // 跟进中
  CONVERTED // 已转签约
  CLOSED // 已关闭
}

// 线索来源渠道
enum LeadSource {
  MINIPROGRAM // 小程序
  WEB // 网页
  FRIEND_SHARE // 朋友分享
  POSTER // 海报扫码
  OFFLINE // 线下到访/电话
  OTHER // 其他
}

// 看房预约状态
enum AppointmentStatus {
  PENDING // 待管家确认排期
  CONFIRMED // 已确认/已排期
  COMPLETED // 已看房
  CANCELLED // 已取消
}

// 公共区域类型
enum PublicAreaType {
  HALLWAY // 走廊
  STAIRWELL // 楼梯间
  ELEVATOR // 电梯
  ROOF // 天台
  ENTRANCE // 入口
  OTHER // 其他
}

// 证件类型
enum IdType {
  ID_CARD // 身份证
  PASSPORT // 护照
  OTHER // 其他
}

// 登记状态
enum RegistrationStatus {
  NOT_REGISTERED // 未登记
  PENDING // 待申报
  REGISTERED // 已登记
  REJECTED // 被驳回
}

// 付款周期
enum PaymentCycle {
  MONTHLY // 月付
  QUARTERLY // 季付
  SEMI_ANNUAL // 半年付
  ANNUAL // 年付
}

// 合同状态
enum ContractStatus {
  DRAFT // 草稿
  ACTIVE // 生效中
  EXPIRED // 已到期
  TERMINATED // 已终止（提前退租）
  RENEWED // 已续签（被新合同替代）
}

// 附件类型
enum AttachmentType {
  CONTRACT_SCAN // 合同扫描件
  ID_PHOTO // 证件照片（第二阶段）
  OTHER // 其他
}

// 账单类型
enum BillType {
  RENT // 租金账单
  UTILITY // 水电费账单（预付账户不足时补缴）
  DEPOSIT // 押金账单
  OTHER // 其他费用
}

// 账单状态
enum BillStatus {
  PENDING // 待缴费
  PARTIAL // 部分缴费
  PAID // 已缴清
  OVERDUE // 逾期
  CANCELLED // 已取消
}

// 收款记录状态（FIN-05）
enum PaymentStatus {
  CONFIRMED // 已确认
  VOIDED // 已作废（原记录保留）
  REVERSAL // 冲正记录（金额为负）
}

// 退款状态（PAY-02）
enum RefundStatus {
  PROCESSING // 退款中
  SUCCESS // 退款成功
  FAILED // 退款失败
  CLOSED // 退款关闭
}

// 对账批次状态（PAY-02）
enum ReconciliationBatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// 对账明细差异类型（PAY-02）
enum ReconciliationItemType {
  MATCHED // 完全匹配平账
  SYSTEM_MISSING // 微信有流水，系统漏单
  WECHAT_MISSING // 系统有记录，微信无记录
  AMOUNT_MISMATCH // 金额不一致
  STATUS_MISMATCH // 状态不一致
}

// 付款方式
enum PaymentMethod {
  CASH // 现金
  BANK_TRANSFER // 银行转账
  WECHAT // 微信
  ALIPAY // 支付宝
  PREPAY // 预付余额抵扣
  OTHER // 其他
}

// 预付交易类型
enum PrepayTransactionType {
  RECHARGE // 充值
  DEDUCTION // 扣费
  REFUND // 退款
  ADJUSTMENT // 调整（管理员手动）
}

// 预付线上充值订单状态
enum PrepayOrderStatus {
  PENDING // 待支付
  SUCCESS // 支付成功已入账
  FAILED // 支付失败
  CANCELLED // 已取消/超时
}

// 关联类型
enum RelatedType {
  METER_READING // 关联读数
  CHECKOUT // 关联退租
  MANUAL_ADJUSTMENT // 手动调整
  ONLINE_RECHARGE // 线上充值
  BILL_DEDUCTION // 账单抵扣
}

// 水电表类型
enum MeterType {
  ELECTRICITY // 电表
  WATER // 水表
  GAS // 燃气表（预留）
}

// 读数来源
enum ReadingSource {
  MANUAL // 手动录入
  DEVICE // 智能设备（第二阶段）
  SIMULATED // 虚拟表模拟器，不计入用量统计和结算
}

// 报修类别
enum MaintenanceCategory {
  PLUMBING // 水管
  ELECTRICAL // 电路
  APPLIANCE // 电器
  FURNITURE // 家具
  DOOR_WINDOW // 门窗
  OTHER // 其他
}

// 报修优先级
enum MaintenancePriority {
  LOW // 低
  NORMAL // 普通
  URGENT // 紧急
}

// 报修状态
enum MaintenanceStatus {
  SUBMITTED // 已提交
  ACKNOWLEDGED // 已受理
  ASSIGNED // 已派单
  IN_PROGRESS // 维修中
  PENDING_CONFIRM // 待确认（等租客确认完成）
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// 退租状态
enum CheckoutStatus {
  DRAFT // 草稿（管理者填写结算单）
  PENDING // 待处理（已提交结算单，等待打款）
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// 退租结算项类型
enum CheckoutItemType {
  RENT_REFUND // 租金退还
  DEPOSIT_REFUND // 押金退还
  DEPOSIT_DEDUCTION // 押金扣除
  UTILITY_REFUND // 水电余额退还
  OTHER_FEE // 其他费用
  OTHER_REFUND // 其他退款
}

// 租金折算方式
enum RentCalculationMethod {
  ACTUAL_DAYS // 实际天数 ÷ 当月天数
  FIXED_30_DAYS // 固定按30天
}

// 用户角色
enum UserRole {
  ADMIN // 管理者
  CLEANER // 保洁
  TENANT // 租客
}

// 外部身份提供方（SEC-04）。后续微信/手机号身份在此扩展，不再往 User 加列。
enum IdentityProvider {
  GOOGLE
  EMAIL
  WECHAT_MP
  PHONE
}

// 邀请码状态
enum InviteCodeStatus {
  UNUSED // 未使用
  USED // 已使用
  REVOKED // 已作废
}

// 通知优先级
enum NotificationPriority {
  NORMAL // 普通
  URGENT // 紧急
}

// 定时任务执行记录
enum JobRunStatus {
  RUNNING
  SUCCESS
  PARTIAL // 子任务有失败但仍跑完（OPS-04 / T277）
  FAILED
  SKIPPED
}

enum JobTrigger {
  CRON
  MANUAL
  QUEUE
}

// 设备类型
enum DeviceType {
  ANDROID
  IOS
  WEB
}

// 租客能力覆写效果
enum CapabilityEffect {
  ALLOW
  DENY
}

// ============================================
// P0 核心表（18张）
// ============================================

// 1. Building（楼栋）
model Building {
  id        String   @id @default(cuid())
  name      String // "XX号楼"
  address   String? // 详细地址
  floors    Int // 楼层数
  metadata  Json? // 扩展信息
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms              Room[]
  publicAreas        PublicArea[]
  contracts          Contract[]
  meters             Meter[]
  publicUtilityBills PublicUtilityBill[]
  floorPlans         FloorPlan[]

  @@index([isActive])
  @@map("buildings")
}

// 2. Room（房间）
model Room {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])

  floor      Int
  roomNumber String
  roomType   RoomType
  area       Decimal? @db.Decimal(6, 2)

  facilities  Json?
  description String? @db.Text

  status      RoomStatus  @default(VACANT)
  cleanStatus CleanStatus @default(CLEAN)

  /// 挂牌月租金（分）
  listingPrice  Int?
  /// 是否上架公开挂牌展示
  isListed      Boolean   @default(true)
  /// 预计起租可用日期
  availableDate DateTime? @db.Date

  version Int @default(0) // 乐观锁

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts           Contract[]
  meters              Meter[]
  maintenanceRequests MaintenanceRequest[]
  checkoutRecords     CheckoutRecord[]
  photos              RoomPhoto[]
  utilityAllocations  PublicUtilityAllocation[]
  roomShape           RoomShape?
  leads               Lead[]
  appointments        ViewingAppointment[]

  @@unique([buildingId, floor, roomNumber])
  @@index([buildingId, status])
  @@index([status, cleanStatus])
  @@map("rooms")
}

model FloorPlan {
  id            String      @id @default(cuid())
  buildingId    String
  building      Building    @relation(fields: [buildingId], references: [id])
  floor         Int
  width         Float
  depth         Float
  backgroundUrl String?
  version       Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  shapes        RoomShape[]

  @@unique([buildingId, floor])
  @@index([buildingId])
  @@map("floor_plans")
}

model RoomShape {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  roomId      String?   @unique
  room        Room?     @relation(fields: [roomId], references: [id])
  kind        ShapeKind @default(RECT)
  x           Float
  y           Float
  width       Float
  depth       Float
  polygon     Json?
  rotation    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([floorPlanId])
  @@map("room_shapes")
}

enum ShapeKind {
  RECT
  POLYGON
}

// 3. PublicArea（公共区域）
model PublicArea {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])

  name     String
  areaType PublicAreaType
  floor    Int?

  createdAt DateTime @default(now())

  meters Meter[]

  @@index([buildingId])
  @@map("public_areas")
}

// 4. Tenant（租客）
model Tenant {
  id    String  @id @default(cuid())
  name  String
  phone String  @unique
  email String? @unique

  emergencyContact String?
  emergencyPhone   String?

  notes String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  contracts           Contract[]
  prepayAccounts      PrepayAccount[]
  prepayRechargeOrders PrepayRechargeOrder[]
  maintenanceRequests MaintenanceRequest[]
  registration        TenantRegistration?
  tags                TenantTag[]
  inviteCodes         InviteCode[]

  @@index([isActive])
  @@index([phone])
  @@map("tenants")
}

// 5. User（用户账号）
model User {
  id           String  @id @default(cuid())
  email        String? @unique
  phone        String? @unique
  passwordHash String?

  googleId  String? @unique
  avatarUrl String?

  role UserRole

  invitedBy String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  /// 邮箱/第三方邮箱已验证时间（SEC-04）；null 表示尚未验证
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant?
  identities          UserIdentity[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  capabilityOverrides UserCapabilityOverride[]

  createdInviteCodes InviteCode[] @relation("CreatedInviteCodes")
  usedInviteCode     InviteCode?  @relation("UsedInviteCode")

  publishedAnnouncements Announcement[] @relation("AnnouncementCreator")

  @@index([email])
  @@index([phone])
  @@index([googleId])
  @@index([role, isActive])
  @@map("users")
}

// 5.1 UserIdentity（外部身份绑定，SEC-04）
model UserIdentity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider       IdentityProvider
  /// GOOGLE 存 sub；EMAIL 存规范化后的邮箱；WECHAT_MP 存 openid
  providerUserId String
  unionId        String?
  email          String?
  emailVerifiedAt DateTime?

  createdAt DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([unionId])
  @@map("user_identities")
}

// 6. Contract（合同）
model Contract {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  contractNumber String @unique

  rentAmount    Int
  depositAmount Int

  paymentCycle PaymentCycle
  paymentDay   Int

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  lateFeeRule Json

  status ContractStatus @default(DRAFT)

  renewedFromId String?   @unique
  renewedFrom   Contract? @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  renewedTo     Contract? @relation("ContractRenewal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills                   Bill[]
  attachments             ContractAttachment[]
  checkoutRecords         CheckoutRecord[]
  utilityAllocations      PublicUtilityAllocation[]
  depositLedger           DepositLedger?

  @@index([buildingId, status])
  @@index([tenantId, status])
  @@index([roomId, status])
  @@index([status, endDate])
  @@map("contracts")
}

// 7. ContractAttachment（合同附件）
model ContractAttachment {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  type     AttachmentType
  fileName String
  fileUrl  String
  fileSize Int
  mimeType String

  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([contractId])
  @@map("contract_attachments")
}

// 8. Bill（账单）
model Bill {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  billNumber String   @unique
  billType   BillType
  period     String

  amount     Int
  paidAmount Int @default(0)

  snapshot Json

  dueDate DateTime   @db.Date
  status  BillStatus @default(PENDING)

  /// 逾期与缴付进度解耦（FIN-04 / T272）：status 只表示 PENDING/PARTIAL/PAID/CANCELLED
  isOverdue   Boolean @default(false)
  overdueDays Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 租金账单为 RENT:{contractId}:{period}。空值表示允许重复，例如同一账期的多笔水电补缴。
  dedupKey String? @unique

  paymentRecords  PaymentRecord[]
  refundRecords   RefundRecord[]
  lateFees        LateFee[]
  lateFeeAccruals LateFeeAccrual[]

  @@index([contractId, status])
  @@index([status, dueDate])
  @@index([isOverdue, dueDate])
  @@map("bills")
}

// 8.1 DepositLedger / DepositTransaction（押金台账，FIN-03 / T267）
enum DepositStatus {
  HELD // 在管
  REFUNDED // 已退还
  PARTIAL // 部分扣除
}

enum DepositTransactionType {
  COLLECT // 收取押金
  REFUND // 退还
  DEDUCT // 扣除
  TRANSFER // 转移至新合同
  REVERSAL // 收款冲正
}

model DepositLedger {
  id         String @id @default(cuid())
  contractId String @unique
  contract   Contract @relation(fields: [contractId], references: [id])

  tenantId String
  roomId   String

  /// 应缴押金（分）
  amount  Int
  /// 当前在管余额（分）
  balance Int @default(0)
  status  DepositStatus @default(HELD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions DepositTransaction[]

  @@index([tenantId])
  @@index([roomId])
  @@map("deposit_ledgers")
}

model DepositTransaction {
  id       String @id @default(cuid())
  ledgerId String
  ledger   DepositLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  type   DepositTransactionType
  /// 正数入账，负数出账
  amount Int
  /// 记账后余额（分）
  balanceAfter Int

  relatedType String?
  relatedId   String?

  operatorId String
  notes      String? @db.Text

  /// 退款、扣款、转移的操作幂等键。空值表示历史流水。
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([ledgerId, createdAt])
  @@map("deposit_transactions")
}

// 9. PaymentRecord（收款记录）
model PaymentRecord {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id])

  amount            Int
  paymentMethod     PaymentMethod
  transactionNumber String?

  status PaymentStatus @default(CONFIRMED)

  /// 客户端幂等键（全局唯一）；同一键重放返回原收款
  idempotencyKey String? @unique
  /// 收据号：R{业务日}{6 位序号}，由数据库序列原子分配
  receiptNumber  String? @unique

  /// 本次收款分配到账单本金/滞纳金的金额（用于精确冲正）
  billPortion    Int  @default(0)
  lateFeePortion Int  @default(0)
  /// [{ lateFeeId, amount }]，按冲正需要精确回滚
  lateFeeAllocations Json?

  voidedAt   DateTime?
  voidedBy   String?
  voidReason String?   @db.Text

  /// 冲正记录指向原收款；一条收款最多一条冲正
  reversalOfId String?         @unique
  reversalOf   PaymentRecord?  @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal     PaymentRecord?  @relation("PaymentReversal")

  paidAt      DateTime @db.Timestamp
  confirmedBy String
  notes       String?  @db.Text

  createdAt DateTime @default(now())

  refundRecords RefundRecord[]

  @@unique([billId, transactionNumber])
  @@index([billId])
  @@index([paidAt])
  @@index([status])
  @@map("payment_records")
}

// 10. LateFee（滞纳金）
model LateFee {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id])

  suggestedAmount Int
  confirmedAmount Int?
  overdueDays     Int

  calculation Json
  notes       String? @db.Text

  confirmedAt DateTime?
  confirmedBy String?

  settledAmount Int? // 已核销金额（分，部分核销累加）
  settledAt     DateTime? // 结清时间
  settledBy     String? // 结清操作人（userId）

  createdAt DateTime @default(now())

  @@index([billId])
  @@map("late_fees")
}

/// 滞纳金按日应计（FIN-04 / T272）：billId + accrualDate 唯一，重复任务幂等。
model LateFeeAccrual {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  accrualDate DateTime @db.Date
  amount      Int
  createdAt   DateTime @default(now())

  @@unique([billId, accrualDate])
  @@index([billId])
  @@map("late_fee_accruals")
}

// 11. PrepayAccount（预付账户）
model PrepayAccount {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  roomId   String

  balanceCache        Int @default(0)
  lowBalanceThreshold Int @default(10000)

  lastNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions   PrepayTransaction[]
  rechargeOrders PrepayRechargeOrder[]

  @@unique([tenantId, roomId])
  @@index([tenantId])
  @@index([balanceCache])
  @@map("prepay_accounts")
}

// 12. PrepayTransaction（预付流水）
model PrepayTransaction {
  id        String        @id @default(cuid())
  accountId String
  account   PrepayAccount @relation(fields: [accountId], references: [id])

  type         PrepayTransactionType
  amount       Int
  balanceAfter Int

  relatedId   String?
  relatedType RelatedType?
  description String

  operatorId String

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([relatedId, relatedType])
  @@map("prepay_transactions")
}

// 12.1 PrepayRechargeOrder（预付线上充值单）
model PrepayRechargeOrder {
  id        String        @id @default(cuid())
  accountId String
  account   PrepayAccount @relation(fields: [accountId], references: [id])
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])

  amount        Int
  outTradeNo    String            @unique
  transactionId String?
  status        PrepayOrderStatus @default(PENDING)
  channel       String            @default("WECHAT")
  paidAt        DateTime?
  receiptNumber String?           @unique

  operatorId  String
  rawResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, createdAt])
  @@index([tenantId, status])
  @@map("prepay_recharge_orders")
}

// 13. Meter（水电表）
model Meter {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])

  roomId       String?
  room         Room?       @relation(fields: [roomId], references: [id])
  publicAreaId String?
  publicArea   PublicArea? @relation(fields: [publicAreaId], references: [id])

  meterType   MeterType
  meterNumber String

  unitPrice          Int
  priceEffectiveDate DateTime @db.Date

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readings           MeterReading[]
  priceHistory       MeterPriceHistory[]
  publicUtilityBills PublicUtilityBill[]

  @@unique([meterNumber])
  @@index([buildingId, meterType])
  @@index([roomId])
  @@index([publicAreaId])
  @@map("meters")
}

// 14. MeterReading（读数记录）
model MeterReading {
  id      String @id @default(cuid())
  meterId String
  meter   Meter  @relation(fields: [meterId], references: [id])

  currentReading  Decimal @db.Decimal(10, 2)
  previousReading Decimal @db.Decimal(10, 2)
  usage           Decimal @db.Decimal(10, 2)

  source      ReadingSource
  readingTime DateTime
  readBy      String?

  notes String? @db.Text

  /// 业务去重键：messageId 或 readingTime+读数+来源摘要；同一块表内唯一
  dedupKey String?

  /// 结算落账时间；为空表示尚未结算（兼容历史 [SETTLED] 备注）
  settledAt        DateTime?
  /// 本次结算覆盖的累计用量
  settledUsage     Decimal? @db.Decimal(10, 2)
  /// 结算时实际采用的生效单价（分）
  settledUnitPrice Int?
  /// 本次结算产生的扣费 + 补缴账单总额（分）
  settledAmount    Int?

  createdAt DateTime @default(now())

  @@unique([meterId, dedupKey])
  @@index([meterId, readingTime])
  @@map("meter_readings")
}

// 15. MaintenanceRequest（报修工单）
