/// 报修工单时间线（COM-03 / T283）：用户留言 + 系统事件，按时间正序展示。
model MaintenanceMessage {
  id        String             @id @default(cuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// MESSAGE=双方留言；SYSTEM=状态/派单/完成等系统事件
  type       MaintenanceMessageType @default(MESSAGE)
  authorId   String?
  authorRole String?
  body       String                 @db.Text

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@map("maintenance_messages")
}

enum MaintenanceMessageType {
  MESSAGE
  SYSTEM
}

// 25. FileAsset（上传文件归属）—— T159 安全修复
//
// 背景：GET /files/:key 原先仅要求登录、无任何归属校验，任何已登录用户
// 拿到 key 即可下载任意文件。上传时登记归属后，下载方可校验。
//
// 说明：
// - uploadedBy 存 User.id，tenantId 存 Tenant.id；二者均为**软引用**（不建外键），
//   以免用户/租客删除流程被文件记录阻塞
// - 历史文件（本表引入前上传的）无记录，按「仅管理员可取」处理
enum FilePurpose {
  ROOM_PHOTO
  CONTRACT
  MAINTENANCE
  AVATAR
  RECEIPT
  OTHER
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

model FileAsset {
  id String @id @default(cuid())

  key          String  @unique
  url          String
  fileName     String?
  fileSize     Int     @default(0)
  mimeType     String?
  thumbnailKey String?

  purpose    FilePurpose    @default(OTHER)
  visibility FileVisibility @default(PRIVATE)
  /// 业务归属，例如 ROOM / CONTRACT / MAINTENANCE；与 ownerId 一起使用
  ownerType String?
  ownerId   String?

  uploadedBy String?
  tenantId   String?

  createdAt DateTime @default(now())

  @@index([uploadedBy])
  @@index([tenantId])
  @@index([visibility])
  @@index([ownerType, ownerId])
  @@map("file_assets")
}

