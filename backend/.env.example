# Database (Docker)
# 本机 5432 被占用时改用 5433（需与 docker-compose 的 POSTGRES_PORT 一致）
DATABASE_URL="postgresql://tenant_user:tenant_password@localhost:5432/tenant_system"
# 整合测试不读取 DATABASE_URL。先 migrate，再跑 backend/scripts/prepare-integration-db.sh。
# 需要另设 INTEGRATION_ADMIN_DATABASE_URL、INTEGRATION_DATABASE_URL、
# INTEGRATION_DATABASE_MARKER（至少 16 字符）、INTEGRATION_TESTER_PASSWORD、
# INTEGRATION_REDIS_URL（db 编号 >= 1）和 ALLOW_INTEGRATION_RESET=true。

# Application
NODE_ENV=development
# 访问日志级别。生产用 info。JSON 日志会脱敏 authorization、password、code。
LOG_LEVEL=info
# 与 frontend-admin 的默认开发代理端口一致，避免本机其他服务占用 3000。
PORT=3100

# JWT
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Upload
# local 写到 UPLOAD_DIR；s3 走下面的 OSS/S3 兼容接口。
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
OSS_ACCESS_KEY_ID=your-oss-key
OSS_ACCESS_KEY_SECRET=your-oss-secret
OSS_BUCKET=tenant-system
OSS_REGION=oss-cn-hangzhou
# S3 兼容存储（MinIO 等）可选覆盖。MinIO 需要 S3_ENDPOINT，并把 S3_FORCE_PATH_STYLE 设为 true。
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-change-this
# 旧名（已弃用，仅兼容旧部署）：两者都设置时以 ENCRYPTION_KEY 为准。
# FIELD_ENCRYPTION_KEY=
# 换钥过渡期的旧钥（逗号分隔，可多把）；只用于解密历史密文，新数据始终用 ENCRYPTION_KEY。
# ENCRYPTION_KEY_PREVIOUS=

# Redis (Docker)
# 生产建议直接用 REDIS_URL（支持密码与 rediss://）；未设置时才回退到 HOST/PORT。
# REDIS_URL=redis://:密码@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Building
DEFAULT_BUILDING_ID=building-001

# Admin Account (for seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Cleaner Account (for seed)。生产 seed 守卫要求显式提供，密码至少 12 位。
CLEANER_EMAIL=cleaner@example.com
CLEANER_PASSWORD=Cleaner@123456

# CORS 允许的前端来源（逗号分隔）。localhost 与 127.0.0.1 属不同 origin，需分别列出。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# Google OAuth 2.0 (可选，留空时使用开发环境模拟验证)
GOOGLE_CLIENT_ID=your-google-client-id-here
# 模拟 Google 登录（mock-google-token:）的显式开关：开发/测试设 true 才启用，
# 且 NODE_ENV 必须是 production 以外的值。生产保持 false。（T206）
GOOGLE_AUTH_MOCK=false

# 邮箱验证码。生产环境必须同时提供 SMTP_HOST、SMTP_USER、SMTP_PASS，否则拒绝发送，且不会把验证码写入日志。
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="栖居生活" <no-reply@qiju.com>

# 万能码 123456 只在 NODE_ENV=development 且此值为 true 时生效。生产环境忽略。
OTP_DEV_BYPASS=true

# 验证码只存 HMAC 摘要。未设置时回退 JWT_SECRET；多实例部署必须一致。
# OTP_HASH_SECRET=

# 登录失败防护：连续失败 5 次锁定 15 分钟；bcrypt cost 默认 12（允许 10–14）。
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCK_MS=900000
# BCRYPT_ROUNDS=12

# 业务时区（IANA）。所有账单日/统计月份/收据日期都按此时区计算。
# BUSINESS_TIMEZONE=Asia/Shanghai

# 反向代理。生产默认信任 1 层；本地直连不要打开，否则客户端可以伪造来源 IP。
# TRUST_PROXY=1

# 限流覆盖。不设置时：全局 100 次/分钟/IP，认证接口 10 次/分钟/IP，
# 发送验证码 5 次/小时/邮箱 + 30 次/小时/IP（两层，换邮箱不能绕过按 IP 那一层）。
# NODE_ENV=test 且这里不设置时，次数自动抬到 100000。
# THROTTLE_GLOBAL_LIMIT=100
# THROTTLE_AUTH_LIMIT=10
# THROTTLE_OTP_LIMIT=5
# THROTTLE_OTP_IP_LIMIT=30

# 虚拟水电表模拟器。默认关闭。只有设为 true 才开放接口和后台入口。生产保持 false。
FEATURE_METER_SIMULATOR=false

# 可观测性与告警（OPS-04 / T277）
# METRICS_TOKEN=
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TOKEN=
# ALERT_MIN_INTERVAL_MS=60000
# SCHEDULER_LOCK_TTL_SECONDS=900

# 后台任务队列（OPS-05 / T278）
# QUEUE_ENABLED=false
# QUEUE_CONCURRENCY=2
# QUEUE_ATTEMPTS=3
# QUEUE_BACKOFF_MS=5000
# QUEUE_PREFIX=tenant-jobs
# PROCESS_ROLE=web

# 多实例部署（OPS-06 / T279）；true 时必须 STORAGE_DRIVER=s3
# MULTI_INSTANCE=false
# INSTANCE_ID=
