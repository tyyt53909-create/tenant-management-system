# Database (Docker)
# 本机 5432 被占用时改用 5433（需与 docker-compose 的 POSTGRES_PORT 一致）
DATABASE_URL="postgresql://tenant_user:tenant_password@localhost:5432/tenant_system"

# Application
NODE_ENV=development
# 与 frontend-admin 的默认开发代理端口一致，避免本机其他服务占用 3000。
PORT=3100

# JWT
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Upload
OSS_ACCESS_KEY_ID=your-oss-key
OSS_ACCESS_KEY_SECRET=your-oss-secret
OSS_BUCKET=tenant-system
OSS_REGION=oss-cn-hangzhou

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-change-this

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# Building
DEFAULT_BUILDING_ID=building-001

# Admin Account (for seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# CORS 允许的前端来源（逗号分隔）。localhost 与 127.0.0.1 属不同 origin，需分别列出。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
