# 生产编排（docker-compose.prod.yml）用的变量模板。
#
# 用法：
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   把全部 CHANGE_ME 换成真实值后：docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ⚠️ .env.prod **不要入库**（见 AGENTS.md §8.2、docs/12-部署与运维.md §1.4）。
# ⚠️ 带 `<必填>` 的项若留空，compose 会因为 `${VAR:?}` 直接拒绝启动。
# ⚠️ 真实值只存在于部署机（或密码管理器）；仓库里只有这份占位模板。
# ⚠️ 后端启动时会按 backend/src/config/env.schema.ts 再校验一次，缺项会一次列全并拒绝启动。

# ---------------------------------------------------------------- 镜像与版本
# 发版时改 TAG（release.yml 会推 :<版本>、:<主次>、:latest 三个标签）
TAG=local
BACKEND_IMAGE=tenant-backend
WEB_IMAGE=tenant-web
WEB_PORT=80
# 启用仓库里 nginx 配置末尾的 443 段（并挂载证书）时才需要
WEB_TLS_PORT=443

# ---------------------------------------------------------------- 数据库
DB_USER=tenant_user
DB_PASSWORD=CHANGE_ME_强密码          # <必填>
DB_NAME=tenant_system
# compose 会由上面三项拼出后端 DATABASE_URL；单独覆盖时取消注释
# DATABASE_URL=postgresql://tenant_user:密码@postgres:5432/tenant_system?schema=public

# ---------------------------------------------------------------- 应用
NODE_ENV=production
# compose 固定容器内 3000；仅本地覆盖时使用
PORT=3000
LOG_LEVEL=info
# 允许的前端来源，逗号分隔；生产必填，禁止 *
CORS_ORIGINS=https://admin.example.com      # <必填>
# 反向代理层数；生产经 nginx 时保持 1
TRUST_PROXY=1

# ---------------------------------------------------------------- Redis
# 生产 Redis 必须设密码；留空时 compose 不传 --requirepass
REDIS_PASSWORD=CHANGE_ME_强密码
# 优先使用 REDIS_URL（可含密码；TLS 用 rediss://）；留空时用 HOST/PORT/PASSWORD/DB
# REDIS_URL=redis://:密码@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------- 应用密钥
# openssl rand -base64 32
JWT_SECRET=CHANGE_ME_至少32字节随机串   # <必填>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# 证件号等字段级加密，必须 32 字节（base64 / 64 位十六进制 / 32 字节原文）
# 生成：openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_32字节随机串   # <必填>
# 旧名，仅兼容旧部署；新部署不要设置
# FIELD_ENCRYPTION_KEY=
# 换钥过渡期的旧钥（逗号分隔，可多把）；只用于解密历史密文，新数据始终用 ENCRYPTION_KEY。
# ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------- 初始账号（仅 seed）
# 只在 `--profile seed run --rm seed` 时注入；后端进程禁止出现这两个密码。
ADMIN_EMAIL=admin@example.com          # <必填>（不可用默认值）
ADMIN_PASSWORD=CHANGE_ME_12位以上        # <必填>（不可用默认值）
CLEANER_EMAIL=cleaner@example.com      # <必填>（不可用默认值）
CLEANER_PASSWORD=CHANGE_ME_12位以上      # <必填>（不可用默认值）

# ---------------------------------------------------------------- 文件存储
# local：写到容器内 UPLOAD_DIR（单实例）；s3：兼容阿里云 OSS 与 MinIO
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------- 邮件（可选）
# 未配置时邮箱验证码无法外发；密码登录不受影响
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------- 第三方登录（可选）
GOOGLE_CLIENT_ID=
# 生产必须 false；后端会拒绝 true
GOOGLE_AUTH_MOCK=false

# ---------------------------------------------------------------- 业务开关
DEFAULT_BUILDING_ID=building-001
# 生产必须 false；后端会拒绝 true
OTP_DEV_BYPASS=false
FEATURE_METER_SIMULATOR=false
# 限流覆盖；留空使用代码默认值（全局 100/分钟/IP，认证 10/分钟/IP，OTP 5/小时/邮箱 + 30/小时/IP）
THROTTLE_GLOBAL_LIMIT=
THROTTLE_AUTH_LIMIT=
THROTTLE_OTP_LIMIT=
THROTTLE_OTP_IP_LIMIT=
# OTP 哈希密钥；留空回退 JWT_SECRET（多实例必须一致）
OTP_HASH_SECRET=
# 登录失败锁定：连续 5 次失败锁定 15 分钟；bcrypt cost 12（允许 10–14）
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MS=900000
BCRYPT_ROUNDS=12
# 业务时区（IANA，默认 Asia/Shanghai）
BUSINESS_TIMEZONE=Asia/Shanghai

# ---------------------------------------------------------------- 前端
# 前端镜像构建期注入；生产必须是 HTTPS 且以 /api 结尾
VITE_API_BASE_URL=/api

# 可观测性与告警（OPS-04 / T277）
# METRICS_TOKEN=
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TOKEN=
# ALERT_MIN_INTERVAL_MS=60000
# SCHEDULER_LOCK_TTL_SECONDS=900

# 后台任务队列（OPS-05 / T278）
# QUEUE_ENABLED=false
# QUEUE_CONCURRENCY=2
# QUEUE_ATTEMPTS=3
# QUEUE_BACKOFF_MS=5000
# QUEUE_PREFIX=tenant-jobs
# PROCESS_ROLE=web
