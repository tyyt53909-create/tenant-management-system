{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["@dcloudio/types"],
    "allowImportingTsExtensions": true,
    "baseUrl": "."
  },
  "include": ["api/**/*.js", "utils/**/*.js", "globals.d.ts", "../shared/src/money.ts", "../shared/src/error-codes.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
