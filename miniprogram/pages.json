      },
      {
        "pagePath": "pages/maintenance/maintenance",
        "iconPath": "static/repair.png",
        "selectedIconPath": "static/repair-active.png",
        "text": "报修"
      },
      {
        "pagePath": "pages/profile/profile",
        "iconPath": "static/user.png",
        "selectedIconPath": "static/user-active.png",
        "text": "我的"
      }
    ]
  },
  "subPackages": [
    {
      "root": "packageA",
      "pages": [
        {
